import java.util.*;

public class JogoDos8 {

    private static final int[] GOAL_STATE = {1, 2, 3, 4, 5, 6, 7, 8, 0};

    // Classe interna para representar cada estado do jogo
    static class Node implements Comparable<Node> {
        int[] board;
        int zeroIndex;
        int g; // Custo real (movimentos até aqui)
        int h; // Heurística (Distância de Manhattan)
        Node parent;
        String move;

        public Node(int[] board, int g, Node parent, String move) {
            this.board = board.clone();
            this.g = g;
            this.parent = parent;
            this.move = move;
            this.zeroIndex = findZero();
            this.h = calculateManhattan();
        }

        private int findZero() {
            for (int i = 0; i < 9; i++) {
                if (board[i] == 0) return i;
            }
            return -1;
        }

        // O Motor da Eficiência: Distância de Manhattan
        private int calculateManhattan() {
            int distance = 0;
            for (int i = 0; i < 9; i++) {
                int value = board[i];
                if (value != 0) {
                    // Posição atual
                    int currRow = i / 3;
                    int currCol = i % 3;
                    // Posição objetivo (value - 1 funciona para 1 a 8)
                    int targetRow = (value - 1) / 3;
                    int targetCol = (value - 1) % 3;
                    
                    distance += Math.abs(currRow - targetRow) + Math.abs(currCol - targetCol);
                }
            }
            return distance;
        }

        public int f() {
            return g + h;
        }

        @Override
        public int compareTo(Node other) {
            return Integer.compare(this.f(), other.f());
        }

        // Rigor no equals e hashCode para o HashSet funcionar corretamente
        @Override
        public boolean equals(Object obj) {
            if (this == obj) return true;
            if (obj == null || getClass() != obj.getClass()) return false;
            Node node = (Node) obj;
            return Arrays.equals(board, node.board);
        }

        @Override
        public int hashCode() {
            return Arrays.hashCode(board);
        }
    }

    public static void solve(int[] initialBoard) {
        PriorityQueue<Node> openSet = new PriorityQueue<>();
        HashSet<Node> closedSet = new HashSet<>();

        Node startNode = new Node(initialBoard, 0, null, "Início");
        openSet.add(startNode);

        // Mapeamento de movimentos baseados no índice 1D: Cima, Baixo, Esquerda, Direita
        int[] moves = {-3, 3, -1, 1};
        String[] moveNames = {"Cima", "Baixo", "Esquerda", "Direita"};

        while (!openSet.isEmpty()) {
            Node current = openSet.poll();

            // Chegou no objetivo?
            if (Arrays.equals(current.board, GOAL_STATE)) {
                printSolution(current);
                return;
            }

            closedSet.add(current);

            int z = current.zeroIndex;
            int zRow = z / 3;
            int zCol = z % 3;

            // Tenta mover para as 4 direções
            for (int i = 0; i < 4; i++) {
                int newZ = z + moves[i];
                int newZRow = newZ / 3;
                int newZCol = newZ % 3;

                // Valida se o movimento é legal (não vaza do tabuleiro 3x3)
                if (newZ >= 0 && newZ < 9 && Math.abs(zRow - newZRow) + Math.abs(zCol - newZCol) == 1) {
                    int[] newBoard = current.board.clone();
                    // Troca o zero de lugar
                    newBoard[z] = newBoard[newZ];
                    newBoard[newZ] = 0;

                    Node neighbor = new Node(newBoard, current.g + 1, current, moveNames[i]);

                    if (!closedSet.contains(neighbor)) {
                        openSet.add(neighbor);
                    }
                }
            }
        }
        System.out.println("Nenhuma solução encontrada.");
    }

    private static void printSolution(Node node) {
        List<Node> path = new ArrayList<>();
        while (node != null) {
            path.add(node);
            node = node.parent;
        }
        Collections.reverse(path);
        
        System.out.println("Solução encontrada em " + (path.size() - 1) + " movimentos:");
        for (Node n : path) {
            System.out.println("Movimento: " + n.move + " | Fator de ramificação (f = " + n.f() + ")");
            System.out.println(n.board[0] + " " + n.board[1] + " " + n.board[2]);
            System.out.println(n.board[3] + " " + n.board[4] + " " + n.board[5]);
            System.out.println(n.board[6] + " " + n.board[7] + " " + n.board[8]);
            System.out.println("-----");
        }
    }

    public static void main(String[] args) {
        // Exemplo de um tabuleiro embaraçado (Solucionável)
        int[] initial = {1, 2, 3, 4, 0, 5, 7, 8, 6};
        solve(initial);
    }
}
